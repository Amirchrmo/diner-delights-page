# ---------------------------------------------------------------------------
# Bergeerd API — environment configuration
# Copy this file to ".env" and adjust the values for your environment.
# ---------------------------------------------------------------------------

# Application
APP_ENV=development            # development | production
PORT=8080
LOG_LEVEL=info                 # debug | info | warn | error

# JWT authentication
# Generate a strong random secret, e.g.:  openssl rand -base64 48
JWT_SECRET=change-me-please-use-a-long-random-string
JWT_EXPIRES_HOURS=24

# Default admin account (seeded on first run if SEED_ADMIN=true)
SEED_ADMIN=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Seed the demo menu data on first run (only when the collection is empty)
SEED_MENU=true

# MongoDB (existing instance on the server)
# - In Docker (server): MONGO_URI=mongodb://mongo:27017
# - Local development:  MONGO_URI=mongodb://localhost:27017  (use an SSH tunnel,
#   see README "Local Development")
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=bergeerd

# MinIO (existing instance on the server)
# - In Docker (server): MINIO_ENDPOINT=minio:9000
# - Local development:  MINIO_ENDPOINT=localhost:9000  (use an SSH tunnel)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=bergeerd
MINIO_USE_SSL=false

# Public base URL where uploaded images are served to the website.
# - In Docker (server): the API/nginx proxy exposes /bergeerd-minio/ -> minio:9000
# - Local development:  http://localhost:9000  (MinIO is accessed directly)
MINIO_PUBLIC_URL=http://localhost:9000

# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
