# Runtime-only image — binary is built on a machine with Go module access.
FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY bergeerd-api /app/bergeerd-api
COPY assets/placeholder.svg /app/assets/placeholder.svg
ENV PORT=8080
EXPOSE 8080
ENTRYPOINT ["/app/bergeerd-api"]
